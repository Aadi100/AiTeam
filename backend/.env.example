# Copy this file to backend/.env and fill in what you need. Everything here is optional except a DeepSeek key
# (which you can also paste into the app: "Models & keys").

# --- Required to do anything useful ---------------------------------------------------------------
# Get one at https://platform.deepseek.com  (top up a few dollars, then API keys)
DEEPSEEK_API_KEY=

# --- Optional: web search for questions about recent facts -----------------------------------------
# Free key at https://tavily.com  (starts with tvly-)
TAVILY_API_KEY=
# 0 on the free plan. Set 0.008 if you pay per search, so the Usage tab includes it.
TAVILY_PRICE_PER_SEARCH=0

# --- Server ---------------------------------------------------------------------------------------
# MongoDB must be running. The database name is the last part of the URI.
MONGO_URI=mongodb://localhost:27017/devsquad
# Password for the first "admin" login. If empty, a random one is generated and saved in backend/.auth.json
APP_PASSWORD=
# 127.0.0.1 = only this computer. Do NOT set 0.0.0.0 unless you put HTTPS and a firewall in front of it.
HOST=127.0.0.1
PORT=5000
# Folders agents may write to (separate several with ; on Windows or : on Mac/Linux). Default: your home folder.
ALLOWED_ROOTS=

# --- Tuning (defaults are fine) ---------------------------------------------------------------------
MAX_WORKERS=6
PLANNER_MODEL=deepseek-chat
WORKER_MODEL=deepseek-chat
# Browser used for the "test in a real browser" step: msedge, chrome or chromium. Default: Edge, then Chrome.
ADION_BROWSER=
# Prices in USD per 1M tokens, used by the token calculator. Check platform.deepseek.com/pricing if they change.
DEEPSEEK_PRICE_HIT=0.028
DEEPSEEK_PRICE_MISS=0.28
DEEPSEEK_PRICE_OUT=0.42
# Only for the voice fallback in browsers other than Chrome/Edge (Whisper speech-to-text)
OPENAI_API_KEY=
